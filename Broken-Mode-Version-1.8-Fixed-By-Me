local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local mainUI = player.PlayerGui:WaitForChild("MainUI")
local mainFrame = mainUI:WaitForChild("MainFrame")
local original = mainFrame:WaitForChild("IntroText")

local intro = original:Clone()
intro.Name = "Broken Mode Intro"
intro.Parent = mainUI
intro.Visible = true

-- THE BROKEN
intro.AnchorPoint = Vector2.new(0.5, 0)
intro.Position = UDim2.new(0.5, 0, 0.04, 0)
intro.Size = UDim2.new(0.92, 0, 0.12, 0)

intro.BackgroundTransparency = 1
intro.Text = "THE BROKEN"
intro.TextTransparency = 1
intro.TextScaled = true
intro.TextColor3 = Color3.fromRGB(170, 170, 170)
intro.Font = Enum.Font.GothamBold

-- UNDERLINE
local underline = intro:FindFirstChild("Underline")

if underline then
	underline.AnchorPoint = Vector2.new(0.5, 0.5)
	underline.Position = UDim2.new(0.5, 0, 1.02, 0)
	underline.Size = UDim2.new(0, 0, 0, 6)

	if underline:IsA("ImageLabel") or underline:IsA("ImageButton") then
		underline.ImageColor3 = Color3.fromRGB(170, 170, 170)
		underline.ImageTransparency = 1
	elseif underline:IsA("Frame") then
		underline.BackgroundColor3 = Color3.fromRGB(170, 170, 170)
		underline.BackgroundTransparency = 1
	end
end

-- FADE IN
TweenService:Create(
	intro,
	TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	{TextTransparency = 0}
):Play()

task.wait(0.5)

-- UNDERLINE APPEARS
if underline then
	local properties = {
		Size = UDim2.new(0.4, 0, 0, 6)
	}

	if underline:IsA("ImageLabel") or underline:IsA("ImageButton") then
		properties.ImageTransparency = 0
	elseif underline:IsA("Frame") then
		properties.BackgroundTransparency = 0
	end

	TweenService:Create(
		underline,
		TweenInfo.new(2.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		properties
	):Play()
end

task.wait(7)

-- FADE OUT
TweenService:Create(
	intro,
	TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
	{TextTransparency = 1}
):Play()

if underline then
	local properties = {
		Size = UDim2.new(0, 0, 0, 6)
	}

	if underline:IsA("ImageLabel") or underline:IsA("ImageButton") then
		properties.ImageTransparency = 1
	elseif underline:IsA("Frame") then
		properties.BackgroundTransparency = 1
	end

	TweenService:Create(
		underline,
		TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		properties
	):Play()
end

task.wait(2.2)

intro:Destroy()

