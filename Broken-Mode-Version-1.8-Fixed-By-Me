local playerGui = player:WaitForChild("PlayerGui")

-- DOORS Guiding Light / Caption Sound (Public Roblox Asset)
local CAPTION_SOUND_ID = "rbxassetid://9114221227"

local function caption(text, duration, fadeOut, replaceOld)
 -- Default parameters
 duration = duration or 3
 if replaceOld == nil then replaceOld = true end

 -- Clean up existing captions if requested
 if replaceOld then
  for _, child in ipairs(playerGui:GetChildren()) do
   if child.Name == "CaptionUI" then
    child:Destroy()
   end
  end
 end

 -- ScreenGui Setup
 local gui = Instance.new("ScreenGui")
 gui.Name = "CaptionUI"
 gui.ResetOnSpawn = false
 gui.Parent = playerGui

 -- Text Label
 local textLabel = Instance.new("TextLabel")
 textLabel.Size = UDim2.new(0.7, 0, 0.11, 0)
 textLabel.Position = UDim2.new(0.5, 0, 0.67, 0)
 textLabel.AnchorPoint = Vector2.new(0.5, 0.5)
 textLabel.BackgroundTransparency = 1
 textLabel.Text = text
 textLabel.Font = Enum.Font.Oswald
 textLabel.TextScaled = true
 textLabel.TextColor3 = Color3.fromRGB(0, 255, 0) -- Pure Vibrant Green
 textLabel.TextTransparency = 0
 textLabel.Parent = gui

 -- Drop Shadow Stroke
 local stroke = Instance.new("UIStroke")
 stroke.Color = Color3.fromRGB(0, 35, 0) -- Deep green outline for contrast
 stroke.Thickness = 2.5
 stroke.Transparency = 0.2
 stroke.Parent = textLabel

 -- Caption Sound Effect
 local sound = Instance.new("Sound")
 sound.SoundId = CAPTION_SOUND_ID
 sound.Volume = 1
 sound.Parent = textLabel
 sound:Play()

 -- Lifetime management
 task.spawn(function()
  task.wait(duration)

  if fadeOut then
   local fadeOutText = TweenService:Create(textLabel, TweenInfo.new(1), {TextTransparency = 1})
   local fadeOutStroke = TweenService:Create(stroke, TweenInfo.new(1), {Transparency = 1})

   fadeOutText:Play()
   fadeOutStroke:Play()

   fadeOutText.Completed:Connect(function()
    gui:Destroy()
   end)
  else
   gui:Destroy()
  end
 end)
end

